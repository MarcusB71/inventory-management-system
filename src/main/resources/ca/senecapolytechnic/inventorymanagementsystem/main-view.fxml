<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="593.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.senecapolytechnic.inventorymanagementsystem.controller.MainViewController">
   <children>
      <VBox prefHeight="593.0" prefWidth="600.0">
         <children>
            <Label text="Inventory Management System">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="15.0" left="10.0" top="10.0" />
               </VBox.margin>
            </Label>
            <VBox prefHeight="301.0" prefWidth="600.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="35.0" prefWidth="580.0">
                     <children>
                        <Label text="Parts">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <TextField fx:id="searchPartsField" promptText="Search...">
                           <HBox.margin>
                              <Insets left="400.0" />
                           </HBox.margin>
                        </TextField>
                     </children>
                  </HBox>
                  <TableView fx:id="partsTable" prefHeight="183.0" prefWidth="580.0">
                    <columns>
                      <TableColumn fx:id="partIDCol" prefWidth="111.99996948242188" text="ID" />
                      <TableColumn fx:id="partNameCol" prefWidth="197.33334350585938" text="Name" />
                        <TableColumn fx:id="partStockCol" prefWidth="120.6666259765625" text="Inventory Level" />
                        <TableColumn fx:id="partPriceCol" minWidth="0.0" prefWidth="166.66668701171875" text="Price" />
                    </columns>
                  </TableView>
                  <HBox prefHeight="45.0" prefWidth="580.0">
                     <children>
                        <Button fx:id="mainAddPart" mnemonicParsing="false" onAction="#addPart" text="Add">
                           <HBox.margin>
                              <Insets right="5.0" top="5.0" />
                           </HBox.margin>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#modifyPart" text="Modify">
                           <HBox.margin>
                              <Insets right="5.0" top="5.0" />
                           </HBox.margin>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#deletePart" text="Delete">
                           <HBox.margin>
                              <Insets top="5.0" />
                           </HBox.margin>
                        </Button>
                     </children>
                  </HBox>
               </children>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
            </VBox>
            <VBox prefHeight="285.0" prefWidth="600.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="35.0" prefWidth="580.0">
                     <children>
                        <Label text="Products">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <TextField fx:id="searchProductsField" promptText="Search...">
                           <HBox.margin>
                              <Insets left="380.0" />
                           </HBox.margin>
                        </TextField>
                     </children>
                  </HBox>
                  <TableView fx:id="productsTable" prefHeight="157.0" prefWidth="580.0">
                     <columns>
                        <TableColumn fx:id="productIDCol" prefWidth="111.99996948242188" text="ID" />
                        <TableColumn fx:id="productNameCol" prefWidth="197.33334350585938" text="Name" />
                        <TableColumn fx:id="productStockCol" prefWidth="120.6666259765625" text="Inventory Level" />
                        <TableColumn fx:id="productPriceCol" minWidth="0.0" prefWidth="166.66668701171875" text="Price" />
                     </columns>
                  </TableView>
                  <HBox prefHeight="45.0" prefWidth="580.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#addProduct" text="Add">
                           <HBox.margin>
                              <Insets right="5.0" top="5.0" />
                           </HBox.margin>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#modifyProduct" text="Modify">
                           <HBox.margin>
                              <Insets right="5.0" top="5.0" />
                           </HBox.margin>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#deleteProduct" text="Delete">
                           <HBox.margin>
                              <Insets top="5.0" />
                           </HBox.margin>
                        </Button>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="45.0" prefWidth="580.0">
                     <children>
                        <Button fx:id="btnSaveToFile" mnemonicParsing="false" onAction="#handleSaveToFile" text="Save Data to File">
                           <HBox.margin>
                              <Insets right="5.0" top="5.0" />
                           </HBox.margin>
                        </Button>
                        <Button fx:id="btnLoadFromFile" mnemonicParsing="false" onAction="#handleLoadFromFile" text="Load Data from File">
                           <HBox.margin>
                              <Insets right="5.0" top="5.0" />
                           </HBox.margin>
                        </Button>
                        <Button fx:id="btnWriteToDB" mnemonicParsing="false" onAction="#handleWriteToDB" text="Write Data on DB">
                           <HBox.margin>
                              <Insets right="5.0" top="5.0" />
                           </HBox.margin>
                        </Button>
                        <Button fx:id="btnLoadFromDB" mnemonicParsing="false" onAction="#handleLoadFromDB" text="Load Data from DB">
                           <HBox.margin>
                              <Insets top="5.0" />
                           </HBox.margin>
                        </Button>
                     </children>
                  </HBox>
               </children>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
               <VBox.margin>
                  <Insets top="15.0" />
               </VBox.margin>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
